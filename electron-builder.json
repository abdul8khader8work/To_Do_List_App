{
  "appId": "com.todolist.app",
  "productName": "Todo List",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "publish": null,
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": "nsis",
    "artifactName": "TodoList-Windows.${ext}"
  },
  "mac": {
    "target": "dmg",
    "artifactName": "TodoList-macOS.${ext}"
  },
  "linux": {
    "target": "AppImage",
    "artifactName": "TodoList-Linux.${ext}"
  }
}
